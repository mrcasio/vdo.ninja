+		<script>
+			async function easycubeLogout(event) {
+				event.preventDefault();
+				const button = event.currentTarget.querySelector('button');
+				button.disabled = true;
+				try {
+					const response = await fetch('/logout', {
+						method: 'POST', credentials: 'same-origin', cache: 'no-store',
+						headers: { 'X-VDO-Action': 'logout' }
+					});
+					if (!response.ok) throw new Error('Logout failed');
+					window.location.reload();
+				} catch {
+					button.disabled = false;
+					alert('Abmelden ist gerade nicht möglich. Bitte versuche es erneut.');
+				}
+			}
+			async function easycubeShowAccount() {
+				const account = document.getElementById('easycubeAccount');
+				if (!account || document.documentElement.classList.contains('show-output')) return;
+				try {
+					const response = await fetch('/api/me', { credentials: 'same-origin', cache: 'no-store' });
+					if (!response.ok) return;
+					const data = await response.json();
+					if (typeof data.username !== 'string' || !data.username) return;
+					document.getElementById('easycubeAccountName').textContent = data.username;
+					account.hidden = false;
+				} catch { /* Keep the page usable if the account label cannot load. */ }
+			}
+			document.addEventListener('DOMContentLoaded', easycubeShowAccount);
+		</script>
